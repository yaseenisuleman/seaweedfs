package app

import (
	"fmt"
	"github.com/seaweedfs/seaweedfs/weed/admin/dash"
)

templ ClusterS3Servers(data dash.ClusterS3ServersData) {
	{{
		dcSet := map[string]bool{}
		verSet := map[string]bool{}
		for _, it := range data.S3Servers {
			if it.DataCenter != "" {
				dcSet[it.DataCenter] = true
			}
			if it.Version != "" {
				verSet[it.Version] = true
			}
		}
	}}
	<div class="tb-page-header">
		<div>
			<div class="tb-pretitle">Cluster</div>
			<h2 class="tb-page-title"><i class="bi bi-cloud me-2 text-secondary"></i>S3 Servers</h2>
		</div>
		<div class="tb-page-actions">
			<button type="button" class="btn tb-btn" onclick="exportS3Servers()">
				<i class="bi bi-download me-1"></i>Export
			</button>
		</div>
	</div>

	<div id="s3-servers-content" class="ops">
		<!-- Summary Cards -->
		<div class="row row-deck g-3 mb-3">
			<div class="col-xl-3 col-sm-6">
				<div class="card tb-stat h-100">
					<div class="card-body">
						<div class="d-flex justify-content-between">
							<div class="subheader">Total S3 servers</div>
						</div>
						<div class="tb-stat-value"><span class="num">{ fmt.Sprintf("%d", data.TotalS3Servers) }</span></div>
						<div class="tb-stat-text">
							if data.TotalS3Servers > 0 {
								<span class="status-dot is-ok me-1"></span>Serving S3 requests
							} else {
								<span class="status-dot me-1"></span>No S3 gateways registered
							}
						</div>
					</div>
				</div>
			</div>
			<div class="col-xl-3 col-sm-6">
				<div class="card tb-stat h-100">
					<div class="card-body">
						<div class="d-flex justify-content-between">
							<div class="subheader">Data centers</div>
						</div>
						<div class="tb-stat-value"><span class="num">{ fmt.Sprintf("%d", len(dcSet)) }</span></div>
						<div class="tb-stat-text">Locations reported by gateways</div>
					</div>
				</div>
			</div>
			<div class="col-xl-3 col-sm-6">
				<div class="card tb-stat h-100">
					<div class="card-body">
						<div class="d-flex justify-content-between">
							<div class="subheader">Versions</div>
						</div>
						<div class="tb-stat-value"><span class="num">{ fmt.Sprintf("%d", len(verSet)) }</span></div>
						<div class="tb-stat-text">
							if len(verSet) > 1 {
								<span class="status-dot is-warn me-1"></span>Mixed versions running
							} else {
								Distinct gateway versions
							}
						</div>
					</div>
				</div>
			</div>
			<div class="col-xl-3 col-sm-6">
				<div class="card tb-stat h-100">
					<div class="card-body">
						<div class="d-flex justify-content-between">
							<div class="subheader">Last updated</div>
						</div>
						<div class="tb-stat-value"><span class="num">{ data.LastUpdated.Format("15:04:05") }</span></div>
						<div class="tb-stat-text">{ data.LastUpdated.Format("2006-01-02") }</div>
					</div>
				</div>
			</div>
		</div>

		<!-- S3 Servers Table -->
		<div class="card shadow mb-4">
			<div class="card-header py-3">
				<h6 class="m-0 font-weight-bold text-primary">
					<i class="bi bi-cloud me-2"></i>S3 Servers
				</h6>
			</div>
			<div class="card-body">
				if len(data.S3Servers) > 0 {
					<div class="table-responsive">
						<table class="table table-hover" id="s3ServersTable">
							<thead>
								<tr>
									<th>Address</th>
									<th>Version</th>
									<th>Data Center</th>
									<th>Created At</th>
								</tr>
							</thead>
							<tbody>
								for _, s3Server := range data.S3Servers {
									<tr>
										<td>
											{ s3Server.Address }
										</td>
										<td>
											<span class="badge bg-light text-dark">{ s3Server.Version }</span>
										</td>
										<td>
											<span class="badge bg-light text-dark">{ s3Server.DataCenter }</span>
										</td>
										<td>
											if !s3Server.CreatedAt.IsZero() {
												{ s3Server.CreatedAt.Format("2006-01-02 15:04:05") }
											} else {
												<span class="text-muted">N/A</span>
											}
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				} else {
					<div class="text-center py-5">
						<i class="bi bi-cloud icon-3x text-muted mb-3"></i>
						<h5 class="text-muted">No S3 Servers Found</h5>
						<p class="text-muted">No S3 servers are currently available in the cluster.</p>
					</div>
				}
			</div>
		</div>

		<!-- Last Updated -->
		<div class="row">
			<div class="col-12">
				<small class="text-muted">
					<i class="bi bi-clock me-1"></i>
					Last updated: { data.LastUpdated.Format("2006-01-02 15:04:05") }
				</small>
			</div>
		</div>
	</div>

	<script>
	function exportS3Servers() {
		const table = document.getElementById('s3ServersTable');
		if (!table) return;

		let csv = 'Address,Version,Data Center,Created At\n';

		const rows = table.querySelectorAll('tbody tr');
		rows.forEach(row => {
			const cells = row.querySelectorAll('td');
			if (cells.length >= 4) {
				const address = cells[0].textContent.trim();
				const version = cells[1].textContent.trim();
				const dataCenter = cells[2].textContent.trim();
				const createdAt = cells[3].textContent.trim();

				csv += `"${address}","${version}","${dataCenter}","${createdAt}"\n`;
			}
		});

		const blob = new Blob([csv], { type: 'text/csv' });
		const url = window.URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = 's3-servers.csv';
		a.click();
		window.URL.revokeObjectURL(url);
	}
	</script>
}
